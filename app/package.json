{
  "name": "lumina-app",
  "productName": "LUMINA",
  "version": "1.2.1",
  "private": true,
  "description": "LUMINA · 综合图像处理软件（风光摄影为特色模块）· Electron UI",
  "main": "../build/app/electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "build:renderer": "node -e \"require('node:fs').rmSync('../build/app/assets',{recursive:true,force:true})\" && vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/print-smoke.ts --bundle --platform=node --external:electron --outdir=../build/app/electron --format=cjs --out-extension:.js=.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "smoke": "cross-env-noop"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
