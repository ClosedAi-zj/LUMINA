# ---- 构建产物与运行时 home（GB 级；含压测实时数据，绝不入库）----
build/

# ---- 依赖 ----
app/node_modules/
mcp/node_modules/

# ---- 测试样张：20 张真实 RW2（561MB，属用户私人照片，不入库）----
samples/

# ---- mock 运行时归档（可再生测试夹具）----
mock-archive/

# ---- thirdparty 构建产物（源码入库，.o/.a/日志/预编译样本工具不入库）----
thirdparty/libraw/object/
thirdparty/libraw/lib/
thirdparty/libraw/bin/
thirdparty/libraw_build.log

# ---- 编译中间产物 ----
*.o
*.obj
*.a
*.lib
*.exp
*.pdb

# ---- 系统杂项 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Python 验证脚本的字节码缓存 ----
# scripts/ 下有一批 gate/verify 脚本，被 import 时会留 __pycache__，不该进仓库。
__pycache__/
*.pyc
